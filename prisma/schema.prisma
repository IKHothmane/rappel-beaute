  SALE
  REFUND_OUT
  CASH_OUT
  CASH_IN
  CLOSING
  EXPENSE
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  WATER
  INTERNET
  SALARY
  MARKETING
  MAINTENANCE
  TRANSPORT
  OFFICE
  PRODUCT_PURCHASE
  OTHER
}

enum ExpenseStatus {
  RECORDED
  VOID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum MovementType {
  PURCHASE
  SERVICE_CONSUMPTION
  SALE
  RETURN
  LOSS
  DAMAGE
  EXPIRATION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
