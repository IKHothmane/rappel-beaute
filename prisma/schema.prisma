  MONTHLY
  YEARLY
}

enum PlatformRole {
  SUPER_ADMIN
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

enum CustomerStatus {
  ACTIVE
  VIP
  NEW
  INACTIVE
  AT_RISK
  ARCHIVED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  ARCHIVED
}

enum LeaveType {
  CONGE
  MALADIE
  ABSENCE
  AUTRE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  MANUAL
  ONLINE_BOOKING
  PHONE
  WHATSAPP
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  ONLINE
  GIFT_CARD
}

enum PaymentStatus {
