  SILVER
  GOLD
  VIP
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  ADJUSTMENT
  EXPIRE
}

enum LoyaltyRewardType {
  DISCOUNT_FIXED
  DISCOUNT_PERCENT
  FREE_SERVICE
}

enum LoyaltyRedemptionStatus {
  APPLIED
  VOID
}

enum PackageStatus {
