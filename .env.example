# =============================================================================
# LOCAL — copier vers .env (jamais committer)
# =============================================================================
# PostgreSQL + Redis via docker-compose up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rappel_beaute?schema=public"
REDIS_URL="redis://localhost:6379"

# Min. 32 caractères — openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# ORIGIN_SECRET : production / staging uniquement. Ne pas le définir en local.
ENCRYPTION_KEY="change-me-encryption-key-32-chars-min"

# Optionnel — futur stockage S3 (logos, exports — pas photos clientes V1)
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=rappel-beaute-local
# S3_PUBLIC_URL=
# S3_REGION=auto
# ALERT_WEBHOOK_URL=
# ALERT_ON_HEALTH_DEGRADED=false

# Google Calendar (OAuth) — lier l'agenda institut
# 1. https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
# 2. Identifiants OAuth « application Web »
# 3. URI de redirection (exact, sans slash final) :
#      http://localhost:3000/api/integrations/google-calendar/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# Google Wallet — identifiant émetteur copié dans la console Google Pay & Wallet.
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_CLASS_SUFFIX=rappel_beauty
# JSON du compte de service : secret Railway uniquement. Ne jamais l'envoyer dans le chat ni le committer.
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# GOOGLE_WALLET_SERVICE_ACCOUNT_PATH=

# Web Push clientes — clés VAPID. Générer avec : npx web-push generate-vapid-keys
# Coller les trois variables dans Railway. Ne jamais committer la clé privée.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@rappelbeauty.com
# Les trois valeurs doivent rester les mêmes d'un déploiement à l'autre.
# Déclenchement planifié, sans ouvrir l'agenda. Secret d'au moins 16 caractères.
# CRON_SECRET=
# Railway peut appeler toutes les minutes :
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<service>/api/cron/customer-push/

# Apple Wallet — certificats hors du dépôt. Sur Railway : PEM ou base64 dans les variables sans _PATH.
# APPLE_PASS_TYPE_ID=pass.com.rappelbeauty.loyalty
# APPLE_TEAM_ID=
# APPLE_PASS_CERT_PATH=
# APPLE_PASS_KEY_PATH=
# APPLE_WWDR_PATH=
# APPLE_PASS_CERT=
# APPLE_PASS_KEY=
# APPLE_WWDR=

# Optionnel — WhatsApp (V1 = envoi manuel via wa.me, pas d'API Meta)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN="rappel-beauty-whatsapp-2026"
#
# Envoi automatique Meta DÉSACTIVÉ par défaut.
# Pour réactiver plus tard :
#   WHATSAPP_DIRECT_SEND_ENABLED=true
#   WHATSAPP_ACCESS_TOKEN=
#   WHATSAPP_APP_SECRET=

# Agent Ads IA — Meta Marketing API (Facebook + Instagram). Lecture seule par défaut.
# META_ADS_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
# META_ADS_WRITES_ENABLED=false

# Email transactionnel (inscription : mot de passe temporaire)
# Compte Resend + domaine vérifié : https://resend.com
# RESEND_API_KEY=
# MAIL_FROM="Rappel Beauty <contact@rappelbeauty.com>"

# Environnement
NODE_ENV=development
# APP_ENV=local

# Migrations LOCAL uniquement :
#   npm run db:migrate        → prisma migrate dev
# STAGING / PRODUCTION :
#   npm run db:migrate:deploy → prisma migrate deploy
# Ne jamais utiliser prisma db push en production.
