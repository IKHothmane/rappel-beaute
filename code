<script>
(function(){
  var chk='<svg class="ico"><use href="#i-check"/></svg>';
  // Onglets produit
  var data={
    agenda:["img/agenda.webp","Agenda de la semaine dans Rappel Beauty","Vue jour, semaine ou mois. Filtrez par praticienne, service, cabine ou statut et repérez d’un coup d’œil les soins à confirmer.",["Conflits de cabine et de machine détectés","Statuts confirmé, en attente, terminé, annulé","Taux d’occupation et CA prévisionnel du jour"]],
    equipe:["img/equipe.webp","Écran Équipe & Planning","Une fiche par collaboratrice avec ses soins autorisés, sa rémunération et ses performances sur 30 jours.",["Habilitations par praticienne","Fixe + commission sur les soins","Rendez-vous, CA généré et satisfaction"]],
    ressources:["img/ressources.webp","Écran Ressources : cabines et machines","Chaque ressource a ses services, son planning et son statut. Une machine en maintenance n’est plus proposée à la réservation.",["Disponible, en cours, en maintenance","Services liés à chaque cabine","Prochain soin visible sur la fiche"]],
    stock:["img/stock.webp","Écran Produits & Stock","Produits de vente et consommables cabine suivis séparément, avec la valeur du stock et la marge par article.",["Alertes sous le seuil et ruptures","Dates d’expiration à surveiller","Entrées, sorties et commandes"]],
    fidelite:["img/fidelite.webp","Écran Programme de fidélité","Un QR code permanent pour votre institut. Au 5ᵉ passage, un code promo est généré automatiquement.",["Scan avec la caméra de la tablette","Objectif, récompense et validité réglables","Page cliente sans application"]]
  };
  var tabs=[].slice.call(document.querySelectorAll(".tab")),stage=document.getElementById("stage"),img=document.getElementById("pImg");
  function show(t){
    tabs.forEach(function(x){var on=x===t;x.setAttribute("aria-selected",on);x.tabIndex=on?0:-1});
    var d=data[t.id.slice(2)];stage.setAttribute("aria-labelledby",t.id);
    img.style.opacity=.3;var n=new Image();n.onload=n.onerror=function(){img.src=d[0];img.alt=d[1];img.style.opacity=1};n.src=d[0];
    document.getElementById("pText").textContent=d[2];
    document.getElementById("pList").innerHTML=d[3].map(function(x){return "<li>"+chk+"<span>"+x+"</span></li>"}).join("");
  }
  tabs.forEach(function(t,i){
    t.addEventListener("click",function(){show(t)});
    t.addEventListener("keydown",function(e){var k=e.key==="ArrowDown"||e.key==="ArrowRight"?1:e.key==="ArrowUp"||e.key==="ArrowLeft"?-1:0;if(!k)return;e.preventDefault();var nt=tabs[(i+k+tabs.length)%tabs.length];nt.focus();show(nt)});
  });
  document.getElementById("pList").innerHTML=data.agenda[3].map(function(x){return "<li>"+chk+"<span>"+x+"</span></li>"}).join("");
  ["equipe","ressources","stock","fidelite"].forEach(function(n){var i=new Image();i.src="img/"+n+".webp"});

  // Étapes WhatsApp
  var notes=["Étape 1 sur 3 · message prêt dans la file « à envoyer »","Étape 2 sur 3 · conversation ouverte, texte prérempli","Étape 3 sur 3 · envoyé, lu et confirmé par la cliente"];
  var steps=document.querySelectorAll(".step"),tk=document.getElementById("tk"),b1=document.getElementById("b1"),b2=document.getElementById("b2"),note=document.getElementById("waNote"),cur=0,timer;
  function setStep(i){cur=i;steps.forEach(function(s,k){s.setAttribute("aria-pressed",k===i)});
    b1.style.opacity=i===0?.55:1;tk.textContent=i===0?"◷":(i===1?"✓":"✓✓");tk.className="ticks"+(i===2?" read":"");
    b2.classList.toggle("is-hidden",i!==2);note.textContent=notes[i];}
  steps.forEach(function(s,k){s.addEventListener("click",function(){clearInterval(timer);setStep(k)})});
  setStep(0);
  if(!matchMedia("(prefers-reduced-motion: reduce)").matches){timer=setInterval(function(){setStep((cur+1)%3)},3400)}

  // Tarif mensuel / annuel
  var bm=document.getElementById("bill-m"),by=document.getElementById("bill-y");
  function bill(y){bm.setAttribute("aria-pressed",!y);by.setAttribute("aria-pressed",y);
    document.getElementById("price").textContent=y?"7 990":"799";
    document.getElementById("per").textContent=y?"DH / an":"DH / mois";
    document.getElementById("priceSub").textContent=y?"Soit 666 DH par mois · 1 598 DH économisés sur l’année":"Facturé chaque mois · résiliable à tout moment";}
  bm.onclick=function(){bill(false)};by.onclick=function(){bill(true)};

  // Formulaire d'essai (à brancher sur votre API)
  function esc(s){return s.replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
  document.getElementById("trial").addEventListener("submit",function(e){
    e.preventDefault();var f=e.target,err=document.getElementById("formErr");
    if(!f.nom.value.trim()||!f.institut.value.trim()||f.tel.value.replace(/\D/g,"").length<9){err.textContent="Indiquez votre nom, le nom de l’institut et un numéro à 10 chiffres.";return}
    document.getElementById("formWrap").innerHTML='<div class="form-ok" role="status"><span class="ic"><svg class="ico"><use href="#i-check"/></svg></span><b>Merci '+esc(f.nom.value.trim().split(" ")[0])+'</b><p>Votre demande pour '+esc(f.institut.value.trim())+' est bien enregistrée. Nous vous contactons sur WhatsApp sous 24 h pour activer votre essai.</p></div>';
  });
})();
</script>
