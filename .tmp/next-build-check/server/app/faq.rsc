2:Td2a,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Quel logiciel utiliser pour gérer un institut de beauté au Maroc ?","acceptedAnswer":{"@type":"Answer","text":"Rappel Beauty est un logiciel SaaS conçu pour les instituts de beauté au Maroc. Il permet de gérer les rendez-vous, clientes, équipe, stock, caisse, fidélité et réservation en ligne depuis une seule plateforme."}},{"@type":"Question","name":"Qu'est-ce que Rappel Beauty ?","acceptedAnswer":{"@type":"Answer","text":"Rappel Beauty est un logiciel de gestion pour les instituts de beauté au Maroc. Il sert à gérer les rendez-vous, les clientes, l'équipe, les services, le stock, la caisse, la fidélité et la réservation en ligne."}},{"@type":"Question","name":"Combien coûte Rappel Beauty ?","acceptedAnswer":{"@type":"Answer","text":"Rappel Beauty coûte 799 DH par mois ou 7 990 DH par an. Une période d'essai gratuite de 7 jours est proposée, sans engagement et sans carte bancaire."}},{"@type":"Question","name":"Que comprend la formule ?","acceptedAnswer":{"@type":"Answer","text":"La formule donne accès aux fonctionnalités de gestion proposées par Rappel Beauty pour les instituts de beauté : rendez-vous, clientes, équipe, services, stock, caisse, fidélité, réservation en ligne et outils de pilotage."}},{"@type":"Question","name":"Combien de temps dure l'essai gratuit ?","acceptedAnswer":{"@type":"Answer","text":"L'essai gratuit dure 7 jours."}},{"@type":"Question","name":"Faut-il une carte bancaire pour essayer ?","acceptedAnswer":{"@type":"Answer","text":"Non. L'essai gratuit de 7 jours ne nécessite pas de carte bancaire."}},{"@type":"Question","name":"Y a-t-il un engagement ?","acceptedAnswer":{"@type":"Answer","text":"Non. La formule est sans engagement."}},{"@type":"Question","name":"Les clientes paient-elles Rappel Beauty ?","acceptedAnswer":{"@type":"Answer","text":"Non. Rappel Beauty est le logiciel utilisé par l'institut. Les clientes règlent directement leurs prestations auprès de l'institut."}},{"@type":"Question","name":"Comment fonctionne la réservation en ligne ?","acceptedAnswer":{"@type":"Answer","text":"Chaque institut peut publier sa page : services, durées et créneaux issus du planning. La cliente réserve auprès de l'institut, et le rendez-vous arrive dans le même agenda."}},{"@type":"Question","name":"Où les clientes paient-elles leurs prestations ?","acceptedAnswer":{"@type":"Answer","text":"Les clientes paient directement à l'institut. Les règlements se font au comptoir : espèces, carte, virement, chèque ou carte cadeau."}},{"@type":"Question","name":"Rappel Beauty est-il une marketplace ?","acceptedAnswer":{"@type":"Answer","text":"Non. Rappel Beauty est un logiciel SaaS destiné aux instituts de beauté. Chaque institut dispose de son propre espace de gestion et peut avoir sa propre page publique de réservation."}},{"@type":"Question","name":"Comment fonctionne WhatsApp avec Rappel Beauty ?","acceptedAnswer":{"@type":"Answer","text":"Le logiciel prépare le message. Depuis la page WhatsApp, un clic sur Envoyer le transmet depuis le numéro WhatsApp de l'institut."}},{"@type":"Question","name":"Les photos des clientes sont-elles utilisées ?","acceptedAnswer":{"@type":"Answer","text":"Non. Aucune photo cliente en V1. Les fiches restent textuelles."}}]}6:T666,{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://rappelbeauty.com/#organization","name":"Rappel Beauty","url":"https://rappelbeauty.com/","logo":"https://rappelbeauty.com/brand/logo.png","description":"Rappel Beauty est un logiciel de gestion pour les instituts de beauté au Maroc.","email":"contact@rappelbeauty.com","telephone":"+212691567246","areaServed":{"@type":"Country","name":"Morocco"}},{"@type":"WebSite","@id":"https://rappelbeauty.com/#website","url":"https://rappelbeauty.com/","name":"Rappel Beauty","publisher":{"@id":"https://rappelbeauty.com/#organization"},"inLanguage":"fr-MA"},{"@type":"SoftwareApplication","@id"