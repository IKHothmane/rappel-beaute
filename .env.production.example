# PRODUCTION — variables Railway (service Next.js)
# Ne jamais committer les valeurs réelles. Ne jamais exposer DATABASE_URL au frontend.

NODE_ENV=production
APP_ENV=production

# Bases (références Railway recommandées)
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DIRECT_DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}

# Secrets — générer : openssl rand -base64 32
# SESSION_SECRET=
# ENCRYPTION_KEY=

# URLs publiques (Cloudflare → Railway)
NEXT_PUBLIC_APP_URL=https://app.rappelbeauty.com
NEXT_PUBLIC_ADMIN_URL=https://admin.rappelbeauty.com
NEXT_PUBLIC_MARKETING_URL=https://www.rappelbeauty.com
APP_BASE_URL=https://app.rappelbeauty.com

# Monitoring (optionnel)
# ALERT_WEBHOOK_URL=
# ALERT_ON_HEALTH_DEGRADED=true
# HEALTH_BASE_URL=https://app.rappelbeauty.com

# Stockage R2 / S3 (optionnel V1)
# S3_ENDPOINT=https://....r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=rappel-beauty-prod
# S3_PUBLIC_URL=https://assets.rappelbeauty.com
