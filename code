<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="icon" href="img/mark.png">
<title>Rappel Beauty</title>
<meta name="description" content="Rappel Beauty, le logiciel de gestion des instituts de beauté au Maroc : agenda, caisse, stock, fidélité et rappels WhatsApp.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
/* Layout: SaaS sobre — hero centré + capture produit pleine largeur, sections alternées blanc / rosé */
:root{
  --bg:#FFFFFF; --bg-soft:#FBF6F7; --card:#FFFFFF; --line:#EEE3E6; --line-2:#E3D3D8;
  --ink:#3A2533; --ink-2:#6B5763; --ink-3:#8A7882;
  --primary:#BA0049; --primary-dark:#900037; --primary-soft:#FCEBF1; --on-primary:#FFFFFF;
  --gold:#C79A3B; --ok:#14804A; --ok-soft:#E5F4EB;
  --rose:#FDF1F5; --rose-2:#F9E1EA;
  --shadow-lg:0 1px 2px rgba(31,22,29,.04),0 24px 60px -24px rgba(31,22,29,.22);
  --shadow-sm:0 1px 2px rgba(31,22,29,.05),0 4px 12px -4px rgba(31,22,29,.08);
  --f-display:"Fraunces",Georgia,"Times New Roman",serif;
  --f-body:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --wrap:1200px; --r:14px; color-scheme:light;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit}
h1,h2,h3,h4{margin:0;text-wrap:balance}
h1,h2{font-family:var(--f-display);font-weight:500;letter-spacing:-.02em;line-height:1.06}
h3{font-size:17px;font-weight:600;line-height:1.3}
p{margin:0}
.ico{width:20px;height:20px;flex-shrink:0;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.wrap{max-width:var(--wrap);margin:0 auto;padding-left:max(24px,env(safe-area-inset-left,0px));padding-right:max(24px,env(safe-area-inset-right,0px))}
section{padding-block:112px}
.soft{background:var(--bg-soft);border-block:1px solid var(--line)}
.label{display:inline-flex;align-items:center;gap:8px;font:600 13px var(--f-body);color:var(--primary)}
.label::before{content:"";width:18px;height:2px;background:currentColor;border-radius:2px}
.head{display:grid;gap:16px;max-width:680px;margin-bottom:56px}
.head.center{margin-inline:auto;text-align:center;justify-items:center}
.head h2{font-size:clamp(34px,4.2vw,50px)}
.head p{color:var(--ink-2);font-size:18px;line-height:1.65}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font:600 15px/1 var(--f-body);text-decoration:none;padding:14px 22px;border-radius:10px;border:1px solid transparent;cursor:pointer;transition:background .15s,border-color .15s,box-shadow .15s}
.btn .ico{width:17px;height:17px}
.btn-primary{background:var(--primary);color:var(--on-primary);box-shadow:0 1px 2px rgba(144,0,55,.3),inset 0 1px 0 rgba(255,255,255,.15)}
.btn-primary:hover{background:var(--primary-dark)}
.btn-ghost{background:var(--card);color:var(--ink);border-color:var(--line-2);box-shadow:var(--shadow-sm)}
.btn-ghost:hover{border-color:var(--ink-3)}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid color-mix(in srgb,var(--primary) 45%,transparent);outline-offset:2px}

/* nav */
.nav{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:saturate(1.4) blur(14px);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;gap:36px;height:72px}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;flex-shrink:0}
.logo img{width:38px;height:38px;object-fit:contain}
.logo b{font-family:var(--f-display);font-size:21px;font-weight:600;letter-spacing:-.01em}
.logo b span{color:var(--primary)}
.nav-links{display:flex;gap:28px}
.nav-links a{text-decoration:none;font-size:14.5px;font-weight:500;color:var(--ink-2)}
.nav-links a:hover{color:var(--ink)}
.nav-end{margin-left:auto;display:flex;align-items:center;gap:18px}
.nav-end a.login{font-size:14.5px;font-weight:600;text-decoration:none}
.nav .btn{padding:11px 16px;font-size:14px}
@media (max-width:960px){.nav-links,.nav-end a.login{display:none}}

/* hero */
.hero{padding-block:88px 0;position:relative;overflow:hidden;text-align:center}
.hero::before{content:"";position:absolute;inset:0;z-index:-2;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:56px 56px;mask-image:radial-gradient(ellipse 70% 55% at 50% 0%,#000 30%,transparent 75%);-webkit-mask-image:radial-gradient(ellipse 70% 55% at 50% 0%,#000 30%,transparent 75%);opacity:.7}
.hero::after{content:"";position:absolute;left:50%;top:38%;width:1100px;height:600px;transform:translateX(-50%);z-index:-1;background:radial-gradient(closest-side,color-mix(in srgb,var(--primary) 18%,transparent),transparent);filter:blur(10px)}
.pill{display:inline-flex;align-items:center;gap:10px;padding:6px 14px 6px 6px;border-radius:999px;border:1px solid var(--line-2);background:var(--card);font-size:13.5px;color:var(--ink-2);text-decoration:none;box-shadow:var(--shadow-sm)}
.pill b{font-size:12px;font-weight:600;color:var(--on-primary);background:var(--primary);padding:3px 9px;border-radius:999px}
.hero h1{font-size:clamp(42px,6.4vw,78px);max-width:16ch;margin:26px auto 0}
.hero h1 em{font-style:italic;color:var(--primary)}
.hero .lede{font-size:clamp(17px,1.6vw,20px);color:var(--ink-2);max-width:58ch;margin:24px auto 0;line-height:1.6}
.ctas{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:36px}
.checks{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 26px;margin-top:24px;font-size:14px;color:var(--ink-3)}
.checks span{display:inline-flex;align-items:center;gap:7px}
.checks .ico{width:16px;height:16px;color:var(--ok);stroke-width:2.4}
.shot-wrap{position:relative;margin-top:72px;padding-bottom:0}
.browser{border-radius:16px 16px 0 0;overflow:hidden;border:1px solid var(--line-2);border-bottom:0;background:var(--card);box-shadow:var(--shadow-lg);padding:8px 8px 0}
.browser .bar{display:flex;align-items:center;gap:7px;padding:6px 8px 12px}
.browser .bar i{width:10px;height:10px;border-radius:50%;background:var(--line-2)}
.browser .bar span{margin:0 auto;font:500 12px var(--f-mono);color:var(--ink-3);background:var(--bg-soft);border:1px solid var(--line);padding:4px 14px;border-radius:7px;display:inline-flex;gap:6px;align-items:center}
.browser .bar span .ico{width:12px;height:12px}
.browser img{width:100%;border-radius:8px 8px 0 0;border:1px solid var(--line);border-bottom:0}
.stat{position:absolute;display:flex;gap:12px;align-items:center;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 16px 12px 12px;box-shadow:var(--shadow-lg)}
.stat .ic{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary)}
.stat.ok .ic{background:var(--ok-soft);color:var(--ok)}
.stat small{display:block;font-size:12px;color:var(--ink-3)}
.stat strong{font-size:16px;font-variant-numeric:tabular-nums}
.stat.s1{left:-28px;top:26%}
.stat.s2{right:-28px;top:52%}
@media (max-width:1280px){.stat.s1{left:12px}.stat.s2{right:12px}}
@media (max-width:760px){.stat{display:none}.hero{padding-top:64px}}

/* benefits */
.benefits{border-top:1px solid var(--line);background:var(--card);position:relative}
.benefits .wrap{display:grid;grid-template-columns:repeat(4,1fr)}
.benefit{display:grid;grid-template-columns:auto 1fr;gap:14px;padding:32px 24px;border-left:1px solid var(--line)}
.benefit:first-child{border-left:0;padding-left:0}
.benefit .ic{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary)}
.benefit h3{font-size:15.5px}
.benefit p{font-size:14px;color:var(--ink-2);margin-top:2px;line-height:1.5}
@media (max-width:960px){.benefits .wrap{grid-template-columns:1fr 1fr}.benefit{padding:24px 0;border-left:0}.benefit:nth-child(even){padding-left:20px;border-left:1px solid var(--line)}.benefit:nth-child(n+3){border-top:1px solid var(--line)}}
@media (max-width:560px){.benefits .wrap{grid-template-columns:1fr}.benefit:nth-child(even){padding-left:0;border-left:0}.benefit:nth-child(n+2){border-top:1px solid var(--line)}}

/* product */
.product{display:grid;grid-template-columns:340px 1fr;gap:40px;align-items:start}
.tablist{display:grid;gap:6px}
.tab{display:grid;grid-template-columns:auto 1fr;gap:14px;text-align:left;padding:16px;border-radius:12px;border:1px solid transparent;background:none;color:var(--ink);font:inherit;cursor:pointer;transition:background .15s,border-color .15s}
.tab:hover{background:var(--bg-soft)}
.tab .ic{width:36px;height:36px;border-radius:9px;display:grid;place-items:center;background:var(--bg-soft);color:var(--ink-2);border:1px solid var(--line)}
.tab b{display:block;font-size:15.5px;font-weight:600}
.tab span.d{display:block;font-size:13.5px;color:var(--ink-3);line-height:1.45;margin-top:2px}
.tab[aria-selected="true"]{background:var(--card);border-color:var(--line-2);box-shadow:var(--shadow-sm)}
.tab[aria-selected="true"] .ic{background:var(--primary);border-color:var(--primary);color:var(--on-primary)}
.stage{min-width:0;display:grid;gap:20px}
.frame{border-radius:14px;border:1px solid var(--line-2);background:var(--card);padding:6px;box-shadow:var(--shadow-lg)}
.frame img{width:100%;aspect-ratio:1681/948;object-fit:cover;object-position:top left;border-radius:9px;transition:opacity .25s}
.stage-copy{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}
.stage-copy p{color:var(--ink-2);font-size:15.5px}
.stage-copy ul{list-style:none;padding:0;margin:0;display:grid;gap:8px;font-size:14.5px}
.stage-copy li{display:flex;gap:9px;align-items:flex-start}
.stage-copy li .ico{width:16px;height:16px;color:var(--primary);stroke-width:2.4;margin-top:3px}
@media (max-width:1000px){.product{grid-template-columns:1fr}.tablist{grid-auto-flow:column;grid-auto-columns:max-content;overflow-x:auto;padding-bottom:6px;scrollbar-width:none}.tab{grid-template-columns:auto auto;align-items:center;padding:10px 14px}.tab span.d{display:none}.tab .ic{width:30px;height:30px}}
@media (max-width:640px){.stage-copy{grid-template-columns:1fr}}

/* whatsapp */
.wa{background:linear-gradient(180deg,var(--rose),var(--bg));border-block:1px solid var(--line);position:relative;overflow:hidden}
.wa::before{content:"";position:absolute;right:-200px;top:-200px;width:700px;height:700px;background:radial-gradient(closest-side,rgba(186,0,73,.10),transparent)}
.wa .wrap{position:relative;display:grid;grid-template-columns:1.1fr 1fr;gap:72px;align-items:center}
.wa .head{margin-bottom:36px}
.flow{display:grid;gap:10px;counter-reset:s}
.step{display:grid;grid-template-columns:auto 1fr;gap:16px;padding:18px 20px;border:1px solid var(--line);border-radius:12px;background:var(--card);cursor:pointer;text-align:left;color:inherit;font:inherit;transition:border-color .2s,box-shadow .2s}
.step:hover{border-color:var(--line-2)}
.step[aria-pressed="true"]{border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft)}
.step .n{counter-increment:s;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font:600 13px var(--f-body);border:1px solid var(--line-2);color:var(--ink-2)}
.step .n::before{content:counter(s)}
.step[aria-pressed="true"] .n{background:var(--primary);border-color:var(--primary);color:#fff}
.step h3{font-size:16px}
.step p{font-size:14.5px;color:var(--ink-2);margin-top:3px}
.step code{font:500 11px var(--f-mono);letter-spacing:.06em;padding:2px 7px;border-radius:5px;background:var(--primary-soft);color:var(--primary);margin-left:8px;vertical-align:2px}
.phone{justify-self:center;width:min(330px,100%);border-radius:40px;padding:10px;background:linear-gradient(160deg,#FFFFFF,#F3DDE6);border:1px solid var(--line-2);box-shadow:0 40px 80px -30px rgba(144,0,55,.35)}
.screen{border-radius:31px;overflow:hidden;background:#EFE7DE;color:#1B2B21;border:1px solid #EAD6DE}
.wa-top{background:#0B5C4F;color:#fff;padding:22px 16px 14px;display:flex;align-items:center;gap:10px}
.wa-av{width:36px;height:36px;border-radius:50%;background:#F6CAD8;color:#900037;display:grid;place-items:center;font-weight:700;font-size:13px}
.wa-top b{font-size:14.5px;display:block;line-height:1.2}
.wa-top small{font-size:11.5px;opacity:.8}
.wa-body{padding:18px 12px 18px;min-height:310px;display:flex;flex-direction:column;gap:8px}
.day{align-self:center;font-size:11px;background:#DDEEF6;color:#3A5560;padding:4px 10px;border-radius:7px;font-weight:500}
.bubble{align-self:flex-end;max-width:86%;background:#D9FDD3;border-radius:10px 2px 10px 10px;padding:9px 11px 6px;font-size:14px;line-height:1.45;box-shadow:0 1px 1px rgba(0,0,0,.08);transition:opacity .35s,transform .35s}
.bubble .t{display:flex;justify-content:flex-end;gap:4px;font-size:10.5px;color:#5A7564;margin-top:3px}
.ticks{color:#8AA294;font-weight:700}.ticks.read{color:#2FA8E3}
.bubble.reply{align-self:flex-start;background:#fff;border-radius:2px 10px 10px 10px}
.is-hidden{opacity:0;transform:translateY(6px)}
.wa-note{text-align:center;font-size:13px;color:var(--ink-3);margin-top:18px}
@media (max-width:960px){.wa .wrap{grid-template-columns:1fr;gap:48px}}

/* modules */
.mods{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.mod{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:24px;display:grid;gap:10px;align-content:start;transition:border-color .2s,box-shadow .2s}
.mod:hover{border-color:var(--line-2);box-shadow:var(--shadow-sm)}
.mod .ic{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary);margin-bottom:6px}
.mod p{font-size:14.5px;color:var(--ink-2);line-height:1.55}
@media (max-width:1000px){.mods{grid-template-columns:repeat(2,1fr)}}
@media (max-width:540px){.mods{grid-template-columns:1fr}}

/* maroc */
.ma{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}
.ma .head{margin-bottom:36px}
.ma-list{display:grid;gap:12px}
.ma-item{display:grid;grid-template-columns:auto 1fr;gap:16px;padding:18px 20px;border:1px solid var(--line);border-radius:12px;background:var(--card)}
.ma-item .ic{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:var(--bg-soft);color:var(--primary);border:1px solid var(--line)}
.ma-item p{color:var(--ink-2);font-size:14.5px;margin-top:2px}
.receipt{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:30px 28px;font-size:14px;box-shadow:var(--shadow-lg);max-width:440px;justify-self:center;width:100%}
.rc-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.rc-head h4{font-family:var(--f-display);font-size:21px;font-weight:600}
.rc-head small{display:block;font:500 12px var(--f-mono);color:var(--ink-3);margin-top:4px}
.paid{font-size:12px;font-weight:600;color:var(--ok);background:var(--ok-soft);padding:4px 10px;border-radius:999px;white-space:nowrap}
.receipt hr{border:0;border-top:1px dashed var(--line-2);margin:18px 0}
.rl{display:flex;justify-content:space-between;gap:12px;font-variant-numeric:tabular-nums;padding:5px 0}
.rl span:first-child{color:var(--ink-2)}
.rl.disc span:last-child{color:var(--ok)}
.rl.tot{font-size:18px;font-weight:700}
.rl.tot span:first-child{color:var(--ink)}
.pay{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:16px}
.pay i{font-style:normal;text-align:center;font-size:13px;font-weight:500;padding:9px 6px;border-radius:9px;border:1px solid var(--line);color:var(--ink-2)}
.pay i.on{border-color:var(--primary);color:var(--primary);background:var(--primary-soft)}
.rc-foot{font-size:12.5px;color:var(--ink-3);margin-top:16px}
@media (max-width:960px){.ma{grid-template-columns:1fr;gap:48px}}

/* analytics */
.wide{border-radius:16px;border:1px solid var(--line-2);background:var(--card);padding:6px;box-shadow:var(--shadow-lg)}
.wide img{width:100%;border-radius:11px}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px}
.kpi{padding:20px 22px;border-left:2px solid var(--primary)}
.kpi b{display:block;font-size:15.5px}
.kpi span{font-size:14.5px;color:var(--ink-2)}
@media (max-width:760px){.kpis{grid-template-columns:1fr}}

/* pricing */
.price{display:grid;grid-template-columns:1.15fr 1fr;gap:28px;align-items:stretch;max-width:1040px;margin:0 auto}
.plan{background:var(--card);border:1px solid var(--line-2);border-radius:20px;box-shadow:var(--shadow-lg);overflow:hidden;display:flex;flex-direction:column}
.plan-top{padding:30px 32px 26px;border-bottom:1px solid var(--line);display:grid;gap:18px}
.plan-name{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.plan-name h3{font-family:var(--f-display);font-size:24px;font-weight:600}
.toggle{display:inline-flex;background:var(--bg-soft);border:1px solid var(--line);border-radius:10px;padding:3px}
.toggle button{font:600 13.5px var(--f-body);border:0;background:none;color:var(--ink-2);padding:8px 14px;border-radius:8px;cursor:pointer}
.toggle button[aria-pressed="true"]{background:var(--card);color:var(--ink);box-shadow:var(--shadow-sm)}
.toggle em{font-style:normal;color:var(--ok);font-size:12px;margin-left:5px}
.amount{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.amount b{font-family:var(--f-display);font-size:64px;font-weight:500;line-height:1;font-variant-numeric:tabular-nums;letter-spacing:-.03em}
.amount span{color:var(--ink-2);font-size:16px}
.price-sub{color:var(--ink-3);font-size:14px;margin-top:-8px}
.plan-body{padding:26px 32px 32px;display:grid;gap:24px;flex:1;align-content:space-between}
.plan-body h4{font-size:13px;font-weight:600;color:var(--ink-3)}
.incl{list-style:none;padding:0;margin:12px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:11px 18px;font-size:14.5px}
.incl li{display:flex;gap:9px;align-items:flex-start}
.incl .ico{width:16px;height:16px;color:var(--primary);stroke-width:2.4;margin-top:3px}
@media (max-width:520px){.incl{grid-template-columns:1fr}.plan-top,.plan-body{padding-inline:22px}}
.side{display:grid;gap:12px;align-content:start}
.note{display:grid;grid-template-columns:auto 1fr;gap:16px;padding:22px;border:1px solid var(--line);border-radius:14px;background:var(--card)}
.note .ic{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary)}
.note p{font-size:14.5px;color:var(--ink-2);margin-top:3px}
@media (max-width:900px){.price{grid-template-columns:1fr}}

/* faq */
.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:64px;align-items:start}
.faq-grid .head{margin-bottom:0;position:sticky;top:110px}
.faq{border-top:1px solid var(--line)}
details{border-bottom:1px solid var(--line)}
summary{cursor:pointer;list-style:none;padding:22px 0;font-weight:600;font-size:16.5px;display:flex;justify-content:space-between;align-items:center;gap:16px}
summary::-webkit-details-marker{display:none}
summary .ico{width:18px;height:18px;color:var(--ink-3);transition:transform .2s}
details[open] summary .ico{transform:rotate(45deg);color:var(--primary)}
details p{padding:0 40px 22px 0;color:var(--ink-2);line-height:1.7}
@media (max-width:900px){.faq-grid{grid-template-columns:1fr;gap:32px}.faq-grid .head{position:static}}

/* cta */
.cta{padding-block:0 112px}
.cta-box{border-radius:24px;background:linear-gradient(135deg,#900037 0%,#BA0049 55%,#D9467C 100%);color:#fff;padding:64px;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;position:relative;overflow:hidden}
.cta-box::before{content:"";position:absolute;left:-160px;bottom:-260px;width:620px;height:620px;background:radial-gradient(closest-side,rgba(255,255,255,.16),transparent)}
.cta-box>*{position:relative}
.cta-box .label{color:#FFE3EC}
.cta-box h2{font-size:clamp(32px,3.8vw,46px);color:#fff;margin-top:14px}
.cta-box p.sub{color:#FFE3EC;font-size:17px;margin-top:16px;max-width:44ch}
.cta-pts{display:grid;gap:10px;margin-top:26px;font-size:15px;color:#FFFFFF}
.cta-pts span{display:flex;gap:10px;align-items:center}
.cta-pts .ico{width:18px;height:18px;color:#FFD0DF}
form{display:grid;gap:14px;background:#FFFFFF;color:#3A2533;border-radius:16px;padding:28px}
form h3{font-size:18px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
label{display:grid;gap:6px;font-size:13px;font-weight:600;color:#56474F}
input,select{font:15px var(--f-body);padding:12px 13px;border-radius:9px;border:1px solid #E3D3D8;background:#FFFFFF;color:#3A2533;width:100%;min-width:0;color-scheme:light}
input::placeholder{color:#A8969F}
input:focus,select:focus{border-color:#BA0049}
form .btn-primary{background:#BA0049;color:#fff;padding:15px}
form .btn-primary:hover{background:#900037}
.legal-s{font-size:12.5px;color:#8A7882;text-align:center}
#formErr{font-size:13.5px;color:#BA0049;min-height:0}
.form-ok{background:#FFFFFF;color:#3A2533;border-radius:16px;padding:32px;display:grid;gap:10px}
.form-ok .ic{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:#E5F4EB;color:#14804A}
.form-ok b{font-family:var(--f-display);font-size:24px;font-weight:600}
.form-ok p{color:#56474F}
@media (max-width:960px){.cta-box{grid-template-columns:1fr;padding:40px 24px;gap:36px}}
@media (max-width:520px){.row{grid-template-columns:1fr}form{padding:22px}}

/* footer */
footer{background:var(--bg-soft);border-top:1px solid var(--line);padding-block:64px 32px;font-size:14.5px;color:var(--ink-2)}
.foot{display:grid;grid-template-columns:1.6fr repeat(3,1fr);gap:40px}
.foot h4{font-size:13px;font-weight:600;color:var(--ink);margin:0 0 14px}
.foot ul{list-style:none;padding:0;margin:0;display:grid;gap:10px}
.foot a{text-decoration:none}.foot a:hover{color:var(--primary)}
.tagline{font:500 11px var(--f-mono);letter-spacing:.16em;text-transform:uppercase;color:var(--primary);margin-top:14px}
.legal{margin-top:48px;padding-top:24px;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;font-size:13px;color:var(--ink-3)}
@media (max-width:800px){.foot{grid-template-columns:1fr 1fr}.foot>div:first-child{grid-column:1/-1}}

@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
