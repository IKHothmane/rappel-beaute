# STAGING — secrets via GitHub Environment « staging », jamais dans le repo
# DATABASE_URL=postgresql://...staging...?schema=public
# DIRECT_DATABASE_URL=postgresql://...staging-direct...
# REDIS_URL=redis://...
# SESSION_SECRET=                    # openssl rand -base64 32
# ENCRYPTION_KEY=                    # différent de production
# ORIGIN_SECRET=                     # règle Cloudflare « Set X-Rappel-Origin », requis au build
# ALERT_WEBHOOK_URL=                 # Slack / Discord / n8n
# ALERT_ON_HEALTH_DEGRADED=false     # true = alerte à chaque 503 health
# S3_ENDPOINT=https://....r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=rappel-beaute-staging
# S3_PUBLIC_URL=https://assets-staging.rappelbeaute.ma
# NODE_ENV=production
# APP_ENV=staging
# APP_URL=https://rappel-beaute-staging.up.railway.app
# NEXT_PUBLIC_APP_URL=https://rappel-beaute-staging.up.railway.app
# TIMEZONE=Africa/Casablanca
# Google Wallet — identifiant émetteur de la console, plus la clé JSON (secret Railway).
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_CLASS_SUFFIX=rappel_beauty
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# Apple Wallet — PEM ou base64, jamais les fichiers dans Git.
# APPLE_PASS_TYPE_ID=pass.com.rappelbeauty.loyalty
# APPLE_TEAM_ID=
# APPLE_PASS_CERT=
# APPLE_PASS_KEY=
# APPLE_WWDR=
