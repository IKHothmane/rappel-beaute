  "stdioServers": {
    "context7": {
      "package": "@upstash/context7-mcp",
      "version": "4.7.0",
      "repository": {
        "url": "git+https://github.com/upstash/context7.git",
        "type": "git",
        "directory": "packages/mcp"
      },
      "args": []
    },
    "playwright": {
      "package": "@playwright/mcp",
      "version": "0.0.85",
      "repository": {
        "url": "git+https://github.com/microsoft/playwright-mcp.git",
        "type": "git"
      },
      "args": [
        "--headless",
        "--browser",
        "chrome"
      ]
    },
    "chrome-devtools": {
      "package": "chrome-devtools-mcp",
      "version": "1.13.0",
      "repository": {
        "url": "git+https://github.com/ChromeDevTools/chrome-devtools-mcp.git",
        "type": "git"
      },
      "args": [
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "railway": {
      "package": "@railway/cli",
      "version": "5.74.0",
      "repository": {
        "url": "git+https://github.com/railwayapp/cli.git",
        "type": "git"
      },
      "args": [
        "mcp"
      ]
    }
  },
  "httpServers": {
    "openaiDeveloperDocs": {
      "url": "https://developers.openai.com/mcp"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "tokenEnv": "GITHUB_PERSONAL_ACCESS_TOKEN"
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp",
      "authentication": "OAuth"
    }
  }
