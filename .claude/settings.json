{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Agent(rb-architect)",
      "Agent(rb-frontend)",
      "Agent(rb-backend)",
      "Agent(rb-database)",
      "Agent(rb-qa)",
      "Agent(rb-security)",
      "Agent(rb-reviewer)",
      "Agent(rb-performance)",
      "Agent(rb-devops)",
      "Agent(rb-docs)",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(npm.cmd run *)",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma migrate status)",
      "Bash(node scripts/dev/*)",
      "Bash(python scripts/dev/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "mcp__context7__*",
      "mcp__playwright__*",
      "mcp__chrome-devtools__*"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(npm run db:migrate:deploy*)",
      "Bash(npm.cmd run db:migrate:deploy*)",
      "Bash(rm -rf*)",
      "Bash(railway up*)",
      "Bash(railway redeploy*)"
    ]
  }
}
