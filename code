      const accordions = document.querySelectorAll('details');
      accordions.forEach((targetDetail) => {
        targetDetail.addEventListener('click', () => {
          accordions.forEach((detail) => {
            if (detail !== targetDetail) {
              detail.removeAttribute('open');
            }
          });
        });
      });
    });
